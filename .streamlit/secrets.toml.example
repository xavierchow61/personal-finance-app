# Streamlit Cloud Secrets 範本
# ─────────────────────────────────────────────
# 複製到 Streamlit Cloud Settings → Secrets
# 本地測試：複製為 .streamlit/secrets.toml（已 gitignore）
# 🚨 切勿 commit secrets.toml 到 git！
# ─────────────────────────────────────────────


# === Gemini API Key ===
# 取得：https://aistudio.google.com/apikey
GEMINI_API_KEY = "your-gemini-api-key-here"


# === Supabase Database（PostgreSQL）===
# 取得：Supabase Dashboard → 你嘅 project → 頂部「Connect」按鈕
# → Transaction Pooler tab → 整段 copy
# 記得將 [YOUR-PASSWORD] 替換成真實密碼！
DATABASE_URL = "postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres"


# === Supabase Auth ===
# 取得：Supabase Dashboard → Project Settings → API
# - Project URL（必須以 https:// 開頭）
# - anon public（係 API key，不是 secret key！anon 可以安全分享畀前端）
SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ..."


# === 舊版本機密碼（Fallback，已可以刪除）===
# 若無設 SUPABASE_URL/ANON_KEY，auth.py 會 fallback 用以下用戶設定
# 但 Supabase Auth 啟用後，呢段唔再使用
#
# [auth.users]
# xavier = "yourpassword"
