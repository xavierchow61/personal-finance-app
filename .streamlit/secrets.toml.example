# Streamlit Cloud Secrets 範本
# ─────────────────────────────────────────────
# 將此檔內容複製到 Streamlit Cloud Settings → Secrets
# 本地測試：複製為 .streamlit/secrets.toml（已 gitignore）
# 🚨 切勿提交 secrets.toml 到 git！
# ─────────────────────────────────────────────


# === Gemini API Key ===
# 取得：https://aistudio.google.com/apikey
GEMINI_API_KEY = "your-gemini-api-key-here"


# === 用戶帳號設定（多人版） ===
# 若呢個 section 完全不寫，登入功能會關閉（本地開發 / demo 模式）
# 每位用戶有獨立 database，存於 data/{username}/ 資料夾
#
# 密碼支援兩種格式：
#   1. 純文字（簡單但不安全）："password123"
#   2. SHA256 雜湊（推薦）："sha256:abc123..."
#      產生雜湊：python -c "from streamlit_app.auth import hash_password; print(hash_password('your-password'))"

[auth.users]
xavier = "yourpassword"
# mary = "anotherpassword"
# john = "sha256:5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8"
