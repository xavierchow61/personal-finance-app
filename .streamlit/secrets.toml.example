# Streamlit Cloud Secrets 範本
# ─────────────────────────────────────────────
# 將此檔內容複製到 Streamlit Cloud 的 Settings → Secrets 介面
# 本地測試時，可改名為 secrets.toml（已加入 .gitignore）
# 🚨 切勿提交 secrets.toml 到 git！
# ─────────────────────────────────────────────

# Gemini Vision API key（從 https://aistudio.google.com/apikey 取得）
GEMINI_API_KEY = "your-gemini-api-key-here"
